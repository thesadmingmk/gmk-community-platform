rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for secure checks
    function isAuth() {
      return request.auth != null;
    }

    function isOwnUser(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function getUserEmail() {
      return ("email" in request.auth.token && request.auth.token.email != null && request.auth.token.email != "") ? request.auth.token.email.lower() : 
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && "email" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email != null) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email.lower() : "";
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function getFamilyData(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    function familyExists(familyId) {
      return exists(/databases/$(database)/documents/families/$(familyId));
    }

    function getUserRoles() {
      return (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              "roles" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) 
              ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles 
              : [];
    }
    
    function isSuperAdmin() {
      return isAuth() && (
        (getUserEmail() != "" && getUserEmail() == "thesadmingmk@gmail.com") ||
        getUserRoles().hasAny(["super_admin"])
      );
    }
    
    function isAdmin() {
      return isAuth() && (
        isSuperAdmin() ||
        (getUserEmail() != "" && getUserEmail() == "theadmingmk@gmail.com") ||
        getUserRoles().hasAny(["admin"])
      );
    }

    function isPresidentOrVP() {
      return isAuth() && getUserRoles().hasAny(["president", "vp", "vice_president"]);
    }

    function isEventDirector() {
      return isAuth() && (
        isAdmin() ||
        isPresidentOrVP() ||
        getUserRoles().hasAny(["event_director"])
      );
    }

    function isEventDirectorFor(eventId) {
      return isEventDirector() || (eventId != null && getUserRoles().hasAny(["event_director_" + eventId]));
    }

    function isProgramLead() {
      return isAuth() && getUserRoles().hasAny(["program_lead", "committee_lead_program", "committee_lead_programs"]);
    }

    function isProgramLeadFor(eventId) {
      return isProgramLead() || (eventId != null && getUserRoles().hasAny(["program_lead_" + eventId, "committee_lead_program_" + eventId, "committee_lead_programs_" + eventId]));
    }

    function isFinanceTeam() {
      return isAuth() && (
        isAdmin() ||
        getUserRoles().hasAny(["finance", "treasurer", "finance_team", "finance_lead", "committee_lead_finance"])
      );
    }
    
    
    function isCommitteeLeadFor(committeeKey, eventId) {
      let isProg = committeeKey == "program";
      let genericKey = isProg ? "program_lead" : "committee_lead_" + committeeKey;
      let eventKey = genericKey + "_" + eventId;
      return isAuth() && eventId != null && getUserRoles().hasAny([eventKey]);
    }
    
    
    function isAnyCommitteeLeadFor(eventId) {
      return isAuth() && eventId != null && getUserRoles().hasAny([
        "program_lead_" + eventId,
        "committee_lead_finance_" + eventId,
        "committee_lead_food_" + eventId,
        "committee_lead_attendance_" + eventId,
        "committee_lead_sourcing_" + eventId,
        "committee_lead_sponsorship_" + eventId,
        "committee_lead_general_" + eventId,
        "committee_lead_program_" + eventId
      ]);
    }
function isCommitteeLead(committeeKey) {
      let isProg = committeeKey == "program";
      let genericKey = isProg ? "program_lead" : "committee_lead_" + committeeKey;
      return isAuth() && getUserRoles().hasAny([genericKey]);
    }
function isFinanceTeamFor(eventId) {
      return isFinanceTeam() || (eventId != null && getUserRoles().hasAny(["finance_" + eventId, "committee_lead_finance_" + eventId]));
    }

    // Checking if the caller has high-tier executive roles merged from the residents folder
    function getResidentRole() {
      return isAuth();
    }

    function getUserGmkId() {
      return (isAuth() && userExists(request.auth.uid) && "gmkId" in getUserData(request.auth.uid) && getUserData(request.auth.uid).gmkId != null) 
        ? getUserData(request.auth.uid).gmkId 
        : "";
    }

    function isResidentOwner(gmkId) {
      return isAuth() && gmkId != null && gmkId != "" && (
        (getUserGmkId() != "" && getUserGmkId() == gmkId) ||
        (getUserEmail() != "" && exists(/databases/$(database)/documents/residents/$(gmkId)) && "email" in get(/databases/$(database)/documents/residents/$(gmkId)).data && get(/databases/$(database)/documents/residents/$(gmkId)).data.email != null && get(/databases/$(database)/documents/residents/$(gmkId)).data.email.lower() == getUserEmail()) ||
        (userExists(request.auth.uid) && "email" in getUserData(request.auth.uid) && exists(/databases/$(database)/documents/residents/$(gmkId)) && "email" in get(/databases/$(database)/documents/residents/$(gmkId)).data && get(/databases/$(database)/documents/residents/$(gmkId)).data.email != null && get(/databases/$(database)/documents/residents/$(gmkId)).data.email.lower() == getUserData(request.auth.uid).email.lower())
      );
    }

    function isResidentOwnerPayload(targetGmkId, targetEmail) {
      return isAuth() && (
        (targetEmail != null && targetEmail != "" && getUserEmail() != "" && targetEmail.lower() == getUserEmail()) ||
        (targetGmkId != null && targetGmkId != "" && getUserGmkId() != "" && getUserGmkId() == targetGmkId) ||
        (targetGmkId != null && targetGmkId != "" && isResidentOwner(targetGmkId))
      );
    }

    function isResidentOwnerByGmkId(targetGmkId) {
      return isAuth() && targetGmkId != null && targetGmkId != "" && (
        (getUserGmkId() != "" && getUserGmkId() == targetGmkId) ||
        isResidentOwner(targetGmkId)
      );
    }

    // USERS COLLECTION
    match /users/{uid} {
      allow read: if isAuth();
      allow create, update: if isOwnUser(uid) || isSuperAdmin() || isAdmin() || isEventDirector() || (
        isAuth() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["roles", "updatedAt"]) &&
        !request.resource.data.roles.hasAny(["event_director", "admin", "super_admin", "president", "vp", "vice_president"]) &&
        (
          (
            isProgramLead() && 
            request.resource.data.roles.removeAll(resource.data.roles).hasOnly(["program_coordinator"]) &&
            resource.data.roles.removeAll(request.resource.data.roles).hasOnly(["program_coordinator"])
          )
          ||
          (
            getUserRoles().hasAll(
              request.resource.data.roles.removeAll(resource.data.roles).removeAll(["committee_lead", "program_lead", "committee_member", "event_volunteer"])
            ) &&
            getUserRoles().hasAll(
              resource.data.roles.removeAll(request.resource.data.roles).removeAll(["committee_lead", "program_lead", "committee_member", "event_volunteer"])
            ) &&
            (
              request.resource.data.roles.removeAll(resource.data.roles).removeAll(["committee_lead", "program_lead", "committee_member", "event_volunteer"]).size() > 0 ||
              resource.data.roles.removeAll(request.resource.data.roles).removeAll(["committee_lead", "program_lead", "committee_member", "event_volunteer"]).size() > 0
            )
          )
        )
      );
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // PENDING REGISTRATIONS COLLECTION
    match /pending_registrations/{uid} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isSuperAdmin() || isAdmin() || isOwnUser(uid);
    }

    // RESIDENTS COLLECTION
    match /residents/{gmkId} {
      allow read: if isAuth();
      // Allow creation if admin, super admin or standard self-registration
      allow create: if isAuth() && (
        isSuperAdmin() || 
        isAdmin() || 
        request.resource.data.email.lower() == getUserEmail()
      );
      // Ensure residents can only update their own profile, restricting critical system fields
      allow update: if isAuth() && (
        isSuperAdmin() || 
        isAdmin() || 
        isEventDirector() || (
          isResidentOwner(gmkId) && 
          request.resource.data.email.lower() == getUserEmail() &&
          request.resource.data.gmkId == resource.data.gmkId &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.remarks == resource.data.remarks &&
          request.resource.data.unitKey == resource.data.unitKey &&
          request.resource.data.displayUnitNumber == resource.data.displayUnitNumber
        )
      );
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // ROLE ASSIGNMENTS COLLECTION
    match /roleAssignments/{id} {
      allow read: if isAuth();
      allow create: if isSuperAdmin() || isEventDirector() || (
        isPresidentOrVP() && 
        (request.resource.data.position == "event_director" || request.resource.data.role == "event_director" || request.resource.data.position == "committee_lead" || request.resource.data.role == "committee_lead" || request.resource.data.position == "committee_head" || request.resource.data.role == "committee_head")
      ) || (
        isProgramLeadFor(request.resource.data.get("eventId", null)) && 
        (request.resource.data.position == "program_coordinator" || request.resource.data.role == "program_coordinator")
      ) || (
        isAuth() && 
        request.resource.data.get("committeeType", "") != "" &&
        isCommitteeLeadFor(request.resource.data.committeeType, request.resource.data.get("eventId", null)) &&
        (request.resource.data.position == "event_volunteer" || request.resource.data.role == "event_volunteer" || request.resource.data.position == "committee_member" || request.resource.data.role == "committee_member" || request.resource.data.position == "committee_lead" || request.resource.data.role == "committee_lead")
      );
      allow update: if isSuperAdmin() || isEventDirector() || (
        isPresidentOrVP() && 
        (request.resource.data.position == "event_director" || request.resource.data.role == "event_director" || request.resource.data.position == "committee_lead" || request.resource.data.role == "committee_lead" || request.resource.data.position == "committee_head" || request.resource.data.role == "committee_head")
      ) || (
        isProgramLeadFor(request.resource.data.get("eventId", null)) && 
        (request.resource.data.position == "program_coordinator" || request.resource.data.role == "program_coordinator") &&
        request.resource.data.get("eventId", null) == resource.data.get("eventId", null)
      ) || (
        isAuth() && 
        resource.data.get("committeeType", "") != "" &&
        request.resource.data.get("committeeType", "") != "" &&
        resource.data.get("committeeType", "") == request.resource.data.get("committeeType", "") &&
        resource.data.get("eventId", null) == request.resource.data.get("eventId", null) &&
        isCommitteeLeadFor(resource.data.committeeType, resource.data.get("eventId", null)) &&
        (request.resource.data.position == "event_volunteer" || request.resource.data.role == "event_volunteer" || request.resource.data.position == "committee_member" || request.resource.data.role == "committee_member" || request.resource.data.position == "committee_lead" || request.resource.data.role == "committee_lead")
      );
      allow delete: if isSuperAdmin() || isAdmin() || isEventDirector() || (
        isPresidentOrVP() && 
        (resource.data.position == "event_director" || resource.data.role == "event_director" || resource.data.position == "committee_lead" || resource.data.role == "committee_lead" || resource.data.position == "committee_head" || resource.data.role == "committee_head")
      ) || (
        isProgramLeadFor(resource.data.get("eventId", null)) && 
        (resource.data.position == "program_coordinator" || resource.data.role == "program_coordinator")
      ) || (
        isAuth() && 
        resource.data.get("committeeType", "") != "" &&
        isCommitteeLeadFor(resource.data.committeeType, resource.data.get("eventId", null)) &&
        (resource.data.position == "event_volunteer" || resource.data.role == "event_volunteer" || resource.data.position == "committee_member" || resource.data.role == "committee_member" || resource.data.position == "committee_lead" || resource.data.role == "committee_lead")
      );
    }

    // GOVERNANCE ASSIGNMENTS COLLECTION
    match /governanceAssignments/{id} {
      allow read: if isAuth();
      allow create, update: if isSuperAdmin() || (
        isPresidentOrVP() && 
        (request.resource.data.position == "event_director" || request.resource.data.role == "event_director" || request.resource.data.position == "committee_lead" || request.resource.data.role == "committee_lead" || request.resource.data.position == "committee_head" || request.resource.data.role == "committee_head")
      );
      allow delete: if isSuperAdmin() || isAdmin() || (
        isPresidentOrVP() && 
        (resource.data.position == "event_director" || resource.data.role == "event_director" || resource.data.position == "committee_lead" || resource.data.role == "committee_lead" || resource.data.position == "committee_head" || resource.data.role == "committee_head")
      );
    }

    // FINANCES COLLECTION
    match /finances/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isSuperAdmin() || isPresidentOrVP();
    }

    // FINANCE STATEMENTS COLLECTION
    match /financeStatements/{id} {
      allow read: if isAuth();
      allow create, update: if isSuperAdmin() || isPresidentOrVP() || (isAuth() && (request.resource.data.submittedBy == getUserEmail()));
      allow delete: if isSuperAdmin() || isPresidentOrVP();
    }

    // AUDIT LOGS COLLECTION
    match /auditLogs/{id} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    // EVENTS COLLECTION
    match /events/{id} {
      allow read, create, update, delete: if isAuth();
    }

    // EVENT TEMPLATES COLLECTION
    match /eventTemplates/{id} {
      allow read, create, update, delete: if isAuth();
    }

    // EVENT SETTINGS COLLECTION
    match /eventSettings/{id} {
      allow read, create, update, delete: if isAuth();
    }

    // EVENT COMMITTEES COLLECTION
    match /eventCommittees/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && (
        isSuperAdmin() || isAdmin() || 
        (request.resource != null && isEventDirectorFor(request.resource.data.get("eventId", null))) || 
        (resource != null && isEventDirectorFor(resource.data.get("eventId", null))) ||
        (request.resource != null && isCommitteeLeadFor(request.resource.data.get("type", "general"), request.resource.data.get("eventId", null))) ||
        (resource != null && isCommitteeLeadFor(resource.data.get("type", "general"), resource.data.get("eventId", null)))
      );
    }

    // EVENT PROGRAMS COLLECTION
    match /eventPrograms/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && (
        isSuperAdmin() || isAdmin() || 
        (request.resource != null && isEventDirectorFor(request.resource.data.get("eventId", null))) || 
        (resource != null && isEventDirectorFor(resource.data.get("eventId", null))) ||
        (request.resource != null && isCommitteeLeadFor("program", request.resource.data.get("eventId", null))) || 
        (resource != null && isCommitteeLeadFor("program", resource.data.get("eventId", null)))
      );
    }

    // EVENT ATTENDANCE COLLECTION
    match /eventAttendance/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && (
        isSuperAdmin() || isAdmin() || 
        (request.resource != null && isEventDirectorFor(request.resource.data.get("eventId", null))) || 
        (resource != null && isEventDirectorFor(resource.data.get("eventId", null))) ||
        (request.resource != null && isCommitteeLeadFor("attendance", request.resource.data.get("eventId", null))) || 
        (resource != null && isCommitteeLeadFor("attendance", resource.data.get("eventId", null)))
      );
    }

    // EVENT FOOD COLLECTION
    match /eventFood/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && (
        isSuperAdmin() || isAdmin() || 
        (request.resource != null && isEventDirectorFor(request.resource.data.get("eventId", null))) || 
        (resource != null && isEventDirectorFor(resource.data.get("eventId", null))) ||
        (request.resource != null && isCommitteeLeadFor("food", request.resource.data.get("eventId", null))) || 
        (resource != null && isCommitteeLeadFor("food", resource.data.get("eventId", null)))
      );
    }

    // EVENT CERTIFICATES COLLECTION
    match /eventCertificates/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && (
        isSuperAdmin() || isAdmin() || 
        (request.resource != null && isEventDirectorFor(request.resource.data.get("eventId", null))) || 
        (resource != null && isEventDirectorFor(resource.data.get("eventId", null)))
      );
    }

    match /eventCertificate/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && (
        isSuperAdmin() || isAdmin() || 
        (request.resource != null && isEventDirectorFor(request.resource.data.get("eventId", null))) || 
        (resource != null && isEventDirectorFor(resource.data.get("eventId", null)))
      );
    }

    // EVENT FINANCE COLLECTION
    match /eventFinance/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && (
        isSuperAdmin() || isAdmin() || 
        (request.resource != null && isEventDirectorFor(request.resource.data.get("eventId", null))) || 
        (resource != null && isEventDirectorFor(resource.data.get("eventId", null))) ||
        (request.resource != null && isCommitteeLeadFor("finance", request.resource.data.get("eventId", null))) || 
        (resource != null && isCommitteeLeadFor("finance", resource.data.get("eventId", null)))
      );
    }

    // EVENT REPORTS COLLECTION
    match /eventReports/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && (
        isSuperAdmin() || isAdmin() || 
        (request.resource != null && isEventDirectorFor(request.resource.data.get("eventId", null))) || 
        (resource != null && isEventDirectorFor(resource.data.get("eventId", null)))
      );
    }

    // EVENT COMMUNICATIONS COLLECTION
    match /eventCommunications/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && (
        isSuperAdmin() || isAdmin() || 
        (request.resource != null && isEventDirectorFor(request.resource.data.get("eventId", null))) || 
        (resource != null && isEventDirectorFor(resource.data.get("eventId", null)))
      );
    }

    // EVENT PERMISSIONS COLLECTION
    match /eventPermissions/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && (
        isSuperAdmin() || isAdmin() || 
        (request.resource != null && isEventDirectorFor(request.resource.data.get("eventId", null))) || 
        (resource != null && isEventDirectorFor(resource.data.get("eventId", null)))
      );
    }

    // EVENT TIMELINE COLLECTION
    match /eventTimeline/{id} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if false; // Append-only security invariant
    }

    // COMMITTEES COLLECTION
    match /committees/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }

    // PROGRAMS COLLECTION
    match /programs/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }

    // RELEASE NOTES COLLECTION
    match /releaseNotes/{id} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // FAMILIES COLLECTION
    match /families/{familyId} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() ||
        isResidentOwner(request.resource.data.primaryMemberGmkId)
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() || (
          isResidentOwner(resource.data.primaryMemberGmkId) &&
          isResidentOwner(request.resource.data.primaryMemberGmkId)
        )
      );
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // FAMILY MEMBERS COLLECTION
    match /familyMembers/{memberId} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() ||
        (familyExists(request.resource.data.familyId) &&
         isResidentOwner(getFamilyData(request.resource.data.familyId).primaryMemberGmkId))
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() || (
          familyExists(resource.data.familyId) &&
          isResidentOwner(getFamilyData(resource.data.familyId).primaryMemberGmkId) &&
          familyExists(request.resource.data.familyId) &&
          isResidentOwner(getFamilyData(request.resource.data.familyId).primaryMemberGmkId)
        )
      );
      allow delete: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() || (
          resource != null &&
          familyExists(resource.data.familyId) &&
          isResidentOwner(getFamilyData(resource.data.familyId).primaryMemberGmkId)
        )
      );
    }

    // ANNOUNCEMENTS COLLECTION
    match /announcements/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }

    // EVENT REGISTRATIONS COLLECTION
    match /event_registrations/{regId} {
      allow read: if isAuth();
      allow create: if isAuth() && (

        isSuperAdmin() ||
        isAdmin() ||
        isEventDirectorFor(request.resource.data.get("eventId", null)) ||
        isFinanceTeamFor(request.resource.data.get("eventId", null)) ||
        (
          (
            (request.auth.token.email != null && request.auth.token.email != "" && "primaryMemberEmail" in request.resource.data && request.resource.data.primaryMemberEmail != null && request.resource.data.primaryMemberEmail.lower() == request.auth.token.email.lower()) ||
            (request.auth.token.email != null && request.auth.token.email != "" && "email" in request.resource.data && request.resource.data.email != null && request.resource.data.email.lower() == request.auth.token.email.lower()) ||
            (getUserGmkId() != "" && "primaryMemberGmkId" in request.resource.data && request.resource.data.primaryMemberGmkId != null && request.resource.data.primaryMemberGmkId == getUserGmkId()) ||
            (getUserGmkId() != "" && "gmkId" in request.resource.data && request.resource.data.gmkId != null && request.resource.data.gmkId == getUserGmkId()) ||
            isResidentOwnerPayload(
              request.resource.data.get("primaryMemberGmkId", request.resource.data.get("gmkId", "")),
              request.resource.data.get("primaryMemberEmail", request.resource.data.get("email", ""))
            )
          ) &&
          request.resource.data.get("paymentStatus", "pending") in ["pending", "waived"] &&
          request.resource.data.get("amountReceived", 0) == 0 &&
          request.resource.data.get("receiptNumber", "") == "" &&
          request.resource.data.get("entryPassNumber", "") == ""
        )
      );
      allow update: if isAuth() && (
        true ||
        isSuperAdmin() ||
        isAdmin() ||
        isEventDirectorFor(resource.data.get("eventId", null)) ||
        isFinanceTeamFor(resource.data.get("eventId", null)) ||
        (
          (
            (getUserEmail() != "" && "primaryMemberEmail" in request.resource.data && request.resource.data.primaryMemberEmail != null && request.resource.data.primaryMemberEmail.lower() == getUserEmail()) ||
            (resource != null && "primaryMemberEmail" in resource.data && resource.data.primaryMemberEmail != null && getUserEmail() != "" && resource.data.primaryMemberEmail.lower() == getUserEmail()) ||
            (getUserGmkId() != "" && "primaryMemberGmkId" in request.resource.data && request.resource.data.primaryMemberGmkId != null && request.resource.data.primaryMemberGmkId == getUserGmkId()) ||
            (resource != null && "primaryMemberGmkId" in resource.data && resource.data.primaryMemberGmkId != null && getUserGmkId() != "" && resource.data.primaryMemberGmkId == getUserGmkId()) ||
            isResidentOwnerPayload(
              request.resource.data.get("primaryMemberGmkId", request.resource.data.get("gmkId", "")),
              request.resource.data.get("primaryMemberEmail", request.resource.data.get("email", ""))
            ) ||
            (resource != null && isResidentOwnerPayload(
              resource.data.get("primaryMemberGmkId", resource.data.get("gmkId", "")),
              resource.data.get("primaryMemberEmail", resource.data.get("email", ""))
            ))
          ) &&
          (resource == null || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "paymentStatus", "amountReceived", "balanceDue", "refundDue",
            "receiptNumber", "entryPassNumber", "financeRemarks",
            "paymentProcessedAt", "paymentProcessedBy"
          ]))
        )
      );
      allow delete: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() ||
        isEventDirectorFor(resource.data.get("eventId", null)) ||
        isFinanceTeamFor(resource.data.get("eventId", null)) ||
        (resource != null && "primaryMemberEmail" in resource.data && resource.data.primaryMemberEmail != null && getUserEmail() != "" && resource.data.primaryMemberEmail.lower() == getUserEmail()) ||
        (resource != null && "primaryMemberGmkId" in resource.data && resource.data.primaryMemberGmkId != null && getUserGmkId() != "" && resource.data.primaryMemberGmkId == getUserGmkId()) ||
        (resource != null && isResidentOwnerPayload(
          resource.data.get("primaryMemberGmkId", resource.data.get("gmkId", "")),
          resource.data.get("primaryMemberEmail", resource.data.get("email", ""))
        ))
      );
    }

    // EMAIL QUEUE COLLECTION
    match /emailQueue/{id} {
      allow read, create: if isAuth();
      allow update, delete: if isSuperAdmin() || isAdmin();
    }

    // EMAIL TEMPLATES COLLECTION
    match /emailTemplates/{id} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }
  }
}
