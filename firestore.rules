rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for secure checks
    function isAuth() {
      return request.auth != null;
    }

    function isOwnUser(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function getUserEmail() {
      return ("email" in request.auth.token && request.auth.token.email != null && request.auth.token.email != "") ? request.auth.token.email.lower() : 
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && "email" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email != null) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email.lower() : "";
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function getFamilyData(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    function familyExists(familyId) {
      return exists(/databases/$(database)/documents/families/$(familyId));
    }

    function isSuperAdmin() {
      return isAuth() && (
        (getUserEmail() != "" && getUserEmail() == "thesadmingmk@gmail.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         "roles" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(["super_admin"]))
      );
    }

    function isAdmin() {
      return isAuth() && (
        isSuperAdmin() ||
        (getUserEmail() != "" && getUserEmail() == "theadmingmk@gmail.com") ||
        (getUserEmail() != "" && exists(/databases/$(database)/documents/roleAssignments/$(getUserEmail() + "_admin"))) ||
        (getUserEmail() != "" && exists(/databases/$(database)/documents/governanceAssignments/$(getUserEmail() + "_admin"))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         "gmkId" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         exists(/databases/$(database)/documents/roleAssignments/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gmkId + "_admin"))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         "gmkId" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         exists(/databases/$(database)/documents/governanceAssignments/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gmkId + "_admin"))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         "roles" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(["admin"]))
      );
    }

    function isPresidentOrVP() {
      return isAuth() && (
        (getUserEmail() != "" && exists(/databases/$(database)/documents/roleAssignments/$(getUserEmail() + "_president"))) ||
        (getUserEmail() != "" && exists(/databases/$(database)/documents/governanceAssignments/$(getUserEmail() + "_president"))) ||
        (getUserEmail() != "" && exists(/databases/$(database)/documents/roleAssignments/$(getUserEmail() + "_vp"))) ||
        (getUserEmail() != "" && exists(/databases/$(database)/documents/governanceAssignments/$(getUserEmail() + "_vp"))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         "gmkId" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         exists(/databases/$(database)/documents/roleAssignments/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gmkId + "_president"))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         "gmkId" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         exists(/databases/$(database)/documents/governanceAssignments/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gmkId + "_president"))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         "gmkId" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         exists(/databases/$(database)/documents/roleAssignments/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gmkId + "_vp"))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         "gmkId" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         exists(/databases/$(database)/documents/governanceAssignments/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gmkId + "_vp"))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         "roles" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(["president", "vp", "vice_president"]))
      );
    }

    function isEventDirector() {
      return isAuth() && (
        isSuperAdmin() ||
        isAdmin() ||
        isPresidentOrVP() ||
        (getUserEmail() != "" && exists(/databases/$(database)/documents/roleAssignments/$(getUserEmail() + "_event_director"))) ||
        (getUserEmail() != "" && exists(/databases/$(database)/documents/governanceAssignments/$(getUserEmail() + "_event_director"))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         "gmkId" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         exists(/databases/$(database)/documents/roleAssignments/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gmkId + "_event_director"))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         "gmkId" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         exists(/databases/$(database)/documents/governanceAssignments/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gmkId + "_event_director"))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         "roles" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(["event_director", "president", "vp", "vice_president", "admin", "super_admin"]))
      );
    }

    function isProgramLead() {
      return isAuth() && (
        (getUserEmail() != "" && (
          exists(/databases/$(database)/documents/roleAssignments/$(getUserEmail() + "_committee_lead_program")) ||
          exists(/databases/$(database)/documents/roleAssignments/$(getUserEmail() + "_committee_lead_program_committee")) ||
          exists(/databases/$(database)/documents/roleAssignments/$(getUserEmail() + "_committee_lead_programs")) ||
          exists(/databases/$(database)/documents/roleAssignments/$(getUserEmail() + "_program_lead")) ||
          exists(/databases/$(database)/documents/governanceAssignments/$(getUserEmail() + "_committee_lead_program"))
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         "roles" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(["program_lead", "committee_lead_program"]))
      );
    }

    // Checking if the caller has high-tier executive roles merged from the residents folder
    function getResidentRole() {
      return isAuth();
    }

    function getUserGmkId() {
      return (isAuth() && userExists(request.auth.uid) && "gmkId" in getUserData(request.auth.uid) && getUserData(request.auth.uid).gmkId != null) 
        ? getUserData(request.auth.uid).gmkId 
        : "";
    }

    function isResidentOwner(gmkId) {
      return isAuth() && gmkId != null && gmkId != "" && (
        (getUserGmkId() != "" && getUserGmkId() == gmkId) ||
        (getUserEmail() != "" && exists(/databases/$(database)/documents/residents/$(gmkId)) && "email" in get(/databases/$(database)/documents/residents/$(gmkId)).data && get(/databases/$(database)/documents/residents/$(gmkId)).data.email != null && get(/databases/$(database)/documents/residents/$(gmkId)).data.email.lower() == getUserEmail()) ||
        (userExists(request.auth.uid) && "email" in getUserData(request.auth.uid) && exists(/databases/$(database)/documents/residents/$(gmkId)) && "email" in get(/databases/$(database)/documents/residents/$(gmkId)).data && get(/databases/$(database)/documents/residents/$(gmkId)).data.email != null && get(/databases/$(database)/documents/residents/$(gmkId)).data.email.lower() == getUserData(request.auth.uid).email.lower())
      );
    }

    function isResidentOwnerPayload(targetGmkId, targetEmail) {
      return isAuth() && 
        targetEmail != null && targetEmail != "" && getUserEmail() != "" && targetEmail.lower() == getUserEmail() && (
          (targetGmkId != null && targetGmkId != "" && getUserGmkId() != "" && getUserGmkId() == targetGmkId) ||
          (targetGmkId != null && targetGmkId != "" && exists(/databases/$(database)/documents/residents/$(targetGmkId)) && "email" in get(/databases/$(database)/documents/residents/$(targetGmkId)).data && get(/databases/$(database)/documents/residents/$(targetGmkId)).data.email != null && get(/databases/$(database)/documents/residents/$(targetGmkId)).data.email.lower() == getUserEmail()) ||
          (getUserGmkId() == "" && targetEmail != null && targetEmail != "" && targetEmail.lower() == getUserEmail())
        );
    }

    // USERS COLLECTION
    match /users/{uid} {
      allow read: if isAuth();
      allow create, update: if isOwnUser(uid) || isSuperAdmin() || isAdmin() || isEventDirector();
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // PENDING REGISTRATIONS COLLECTION
    match /pending_registrations/{uid} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isSuperAdmin() || isAdmin() || isOwnUser(uid);
    }

    // RESIDENTS COLLECTION
    match /residents/{gmkId} {
      allow read: if isAuth();
      // Allow creation if admin, super admin or standard self-registration
      allow create: if isAuth() && (
        isSuperAdmin() || 
        isAdmin() || 
        request.resource.data.email.lower() == getUserEmail()
      );
      // Ensure residents can only update their own profile, restricting critical system fields
      allow update: if isAuth() && (
        isSuperAdmin() || 
        isAdmin() || 
        isEventDirector() || (
          isResidentOwner(gmkId) && 
          request.resource.data.email.lower() == getUserEmail() &&
          request.resource.data.gmkId == resource.data.gmkId &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.remarks == resource.data.remarks &&
          request.resource.data.unitKey == resource.data.unitKey &&
          request.resource.data.displayUnitNumber == resource.data.displayUnitNumber
        )
      );
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // ROLE ASSIGNMENTS COLLECTION
    match /roleAssignments/{id} {
      allow read: if isAuth();
      allow create, update: if isSuperAdmin() || isEventDirector() || (
        isPresidentOrVP() && 
        (request.resource.data.position == "event_director" || request.resource.data.role == "event_director" || request.resource.data.position == "committee_lead" || request.resource.data.role == "committee_lead" || request.resource.data.position == "committee_head" || request.resource.data.role == "committee_head")
      );
      allow delete: if isSuperAdmin() || isAdmin() || isEventDirector() || (
        isPresidentOrVP() && 
        (resource.data.position == "event_director" || resource.data.role == "event_director" || resource.data.position == "committee_lead" || resource.data.role == "committee_lead" || resource.data.position == "committee_head" || resource.data.role == "committee_head")
      );
    }

    // GOVERNANCE ASSIGNMENTS COLLECTION
    match /governanceAssignments/{id} {
      allow read: if isAuth();
      allow create, update: if isSuperAdmin() || (
        isPresidentOrVP() && 
        (request.resource.data.position == "event_director" || request.resource.data.role == "event_director" || request.resource.data.position == "committee_lead" || request.resource.data.role == "committee_lead" || request.resource.data.position == "committee_head" || request.resource.data.role == "committee_head")
      );
      allow delete: if isSuperAdmin() || isAdmin() || (
        isPresidentOrVP() && 
        (resource.data.position == "event_director" || resource.data.role == "event_director" || resource.data.position == "committee_lead" || resource.data.role == "committee_lead" || resource.data.position == "committee_head" || resource.data.role == "committee_head")
      );
    }

    // FINANCES COLLECTION
    match /finances/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isSuperAdmin() || isPresidentOrVP();
    }

    // FINANCE STATEMENTS COLLECTION
    match /financeStatements/{id} {
      allow read: if isAuth();
      allow create, update: if isSuperAdmin() || isPresidentOrVP() || (isAuth() && (request.resource.data.submittedBy == getUserEmail()));
      allow delete: if isSuperAdmin() || isPresidentOrVP();
    }

    // AUDIT LOGS COLLECTION
    match /auditLogs/{id} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if false; // Immutable audit trail security constraint
    }

    // EVENTS COLLECTION
    match /events/{id} {
      allow read, create, update, delete: if isAuth();
    }

    // EVENT TEMPLATES COLLECTION
    match /eventTemplates/{id} {
      allow read, create, update, delete: if isAuth();
    }

    // EVENT SETTINGS COLLECTION
    match /eventSettings/{id} {
      allow read, create, update, delete: if isAuth();
    }

    // EVENT COMMITTEES COLLECTION
    match /eventCommittees/{id} {
      allow read, create, update, delete: if isAuth();
    }

    // EVENT PROGRAMS COLLECTION
    match /eventPrograms/{id} {
      allow read, create, update, delete: if isAuth();
    }

    // EVENT ATTENDANCE COLLECTION
    match /eventAttendance/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() ||
        isEventDirector() ||
        isResidentOwnerPayload(request.resource.data.gmkId, request.resource.data.email)
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() ||
        isEventDirector() ||
        isResidentOwnerPayload(request.resource.data.gmkId, request.resource.data.email) ||
        (resource != null && isResidentOwnerPayload(resource.data.gmkId, resource.data.email))
      );
      allow delete: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() ||
        isEventDirector() ||
        (resource != null && isResidentOwnerPayload(resource.data.gmkId, resource.data.email))
      );
    }

    // EVENT FOOD COLLECTION
    match /eventFood/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() ||
        isEventDirector() ||
        isResidentOwnerPayload(request.resource.data.gmkId, request.resource.data.email)
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() ||
        isEventDirector() ||
        isResidentOwnerPayload(request.resource.data.gmkId, request.resource.data.email) ||
        (resource != null && isResidentOwnerPayload(resource.data.gmkId, resource.data.email))
      );
      allow delete: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() ||
        isEventDirector() ||
        (resource != null && isResidentOwnerPayload(resource.data.gmkId, resource.data.email))
      );
    }

    // EVENT CERTIFICATES COLLECTION
    match /eventCertificates/{id} {
      allow read, create, update, delete: if isAuth();
    }

    match /eventCertificate/{id} {
      allow read, create, update, delete: if isAuth();
    }

    // EVENT FINANCE COLLECTION
    match /eventFinance/{id} {
      allow read, create, update, delete: if isAuth();
    }

    // EVENT REPORTS COLLECTION
    match /eventReports/{id} {
      allow read, create, update, delete: if isAuth();
    }

    // EVENT COMMUNICATIONS COLLECTION
    match /eventCommunications/{id} {
      allow read, create, update, delete: if isAuth();
    }

    // EVENT PERMISSIONS COLLECTION
    match /eventPermissions/{id} {
      allow read, create, update, delete: if isAuth();
    }

    // EVENT TIMELINE COLLECTION
    match /eventTimeline/{id} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if false; // Append-only security invariant
    }

    // COMMITTEES COLLECTION
    match /committees/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }

    // PROGRAMS COLLECTION
    match /programs/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }

    // RELEASE NOTES COLLECTION
    match /releaseNotes/{id} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // FAMILIES COLLECTION
    match /families/{familyId} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() ||
        isResidentOwner(request.resource.data.primaryMemberGmkId)
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() || (
          isResidentOwner(resource.data.primaryMemberGmkId) &&
          isResidentOwner(request.resource.data.primaryMemberGmkId)
        )
      );
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // FAMILY MEMBERS COLLECTION
    match /familyMembers/{memberId} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() ||
        (familyExists(request.resource.data.familyId) &&
         isResidentOwner(getFamilyData(request.resource.data.familyId).primaryMemberGmkId))
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() || (
          familyExists(resource.data.familyId) &&
          isResidentOwner(getFamilyData(resource.data.familyId).primaryMemberGmkId) &&
          familyExists(request.resource.data.familyId) &&
          isResidentOwner(getFamilyData(request.resource.data.familyId).primaryMemberGmkId)
        )
      );
      allow delete: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() || (
          resource != null &&
          familyExists(resource.data.familyId) &&
          isResidentOwner(getFamilyData(resource.data.familyId).primaryMemberGmkId)
        )
      );
    }

    // ANNOUNCEMENTS COLLECTION
    match /announcements/{id} {
      allow read: if isAuth();
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }

    // EVENT REGISTRATIONS COLLECTION
    match /event_registrations/{regId} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() ||
        isEventDirector() ||
        isResidentOwnerPayload(request.resource.data.primaryMemberGmkId, request.resource.data.primaryMemberEmail)
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() ||
        isEventDirector() ||
        isResidentOwnerPayload(request.resource.data.primaryMemberGmkId, request.resource.data.primaryMemberEmail) ||
        (resource != null && isResidentOwnerPayload(resource.data.primaryMemberGmkId, resource.data.primaryMemberEmail))
      );
      allow delete: if isAuth() && (
        isSuperAdmin() ||
        isAdmin() ||
        isEventDirector() ||
        (resource != null && isResidentOwnerPayload(resource.data.primaryMemberGmkId, resource.data.primaryMemberEmail))
      );
    }

    // EMAIL QUEUE COLLECTION
    match /emailQueue/{id} {
      allow read, create: if isAuth();
      allow update, delete: if isSuperAdmin() || isAdmin();
    }

    // EMAIL TEMPLATES COLLECTION
    match /emailTemplates/{id} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }
  }
}
